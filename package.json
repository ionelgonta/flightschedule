{
  "name": "flight-schedule",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:with-ota": "node start-with-ota.js",
    "build": "next build",
    "build:fast": "SKIP_ENV_VALIDATION=1 next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "node server.js",
    "start:with-ota": "node start-with-ota.js",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:properties": "jest __tests__/persistent-flight-system.test.ts --verbose",
    "clean": "rm -rf .next out dist build node_modules/.cache",
    "prebuild": "npm run type-check"
  },
  "dependencies": {
    "@google-cloud/vision": "^5.3.4",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.0.1",
    "axios": "^1.13.2",
    "better-sqlite3": "^12.5.0",
    "canvas": "^3.2.0",
    "form-data": "^4.0.5",
    "google-auth-library": "^10.5.0",
    "jimp": "^1.6.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.294.0",
    "multer": "^2.0.2",
    "next": "14.0.4",
    "node-fetch": "^3.3.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdf-poppler": "^0.2.3",
    "pdf2pic": "^3.2.0",
    "pdfjs-dist": "^5.4.530",
    "pdfkit": "^0.17.2",
    "postcss": "^8",
    "qrcode": "^1.5.4",
    "qrcode-reader": "^1.0.4",
    "react": "^18",
    "react-dom": "^18",
    "react-dropzone": "^14.3.8",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.3.0",
    "tesseract.js": "^7.0.0",
    "typescript": "^5",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/qrcode": "^1.5.6",
    "eslint": "^8",
    "eslint-config-next": "14.0.4",
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "ts-jest": "^29.1.1"
  },
  "description": "A modern, high-performance website that displays real-time flight schedules (arrivals and departures) from major airports worldwide. Built with Next.js 14, TypeScript, and TailwindCSS, optimized for SEO and monetization.",
  "main": "analyze-new-pdfs.js",
  "directories": {
    "lib": "lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ionelgonta/flightschedule.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
