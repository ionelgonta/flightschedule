# Existing environment variables
# ... (keep existing variables)

# OTA Module Configuration
OTA_BASE_URL=http://localhost:3002

# Google Wallet Configuration (for OTA module)
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_WALLET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----"
GOOGLE_WALLET_ISSUER_ID=your-issuer-id
GOOGLE_WALLET_CLASS_ID=ota_boarding_pass_class

# Email Configuration for OTA (can reuse existing email config)
OTA_EMAIL_USER=your-email@gmail.com
OTA_EMAIL_PASS=your-app-password
OTA_EMAIL_FROM=noreply@anyway.ro

# OTA JWT Secret
OTA_JWT_SECRET=your-super-secret-ota-jwt-key